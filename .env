# === GenPlat Langfuse Proxy ===
# URL base do proxy da GenPlat para o Langfuse
LANGFUSE_PROXY_URL=https://genplat-langfuse.ifoodcorp.com.br/v1

# Lista de projetos Langfuse que você tem acesso via proxy
# Separe múltiplos projetos por vírgula
LANGFUSE_PROJECTS=logistics-driver-support-agent-staging,genplat-eval-scrapper,ops-customer-support-agent,ifood-agent-starter-pack,genplat-eval-runner,maria-brain-service,agent-cross-memory-service,cris-de,aai-sabia-intelligence,diana-agent-squad,logistics-driver-support-agent,rag-service,the-architect

# Requester Token (opcional — se não definido, o servidor lê de ~/.config/tompero/requester_token)
# REQUESTER_TOKEN=eyJhbG...
